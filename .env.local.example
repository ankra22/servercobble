# Supabase — projeto usado tanto pelo site quanto pelo script Python de captura de logs.
# Copie este arquivo para ".env.local" e preencha com os valores do seu projeto
# (Supabase Dashboard > Project Settings > API).

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-publica

# Somente necessário se algum dia o próprio site precisar escrever no banco
# (o script Python já usa a service_role key por conta própria).
# NUNCA exponha esta chave com o prefixo NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=
