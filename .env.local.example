# Supabase — projeto usado tanto pelo site quanto pelo script Python de captura de logs.
# Copie este arquivo para ".env.local" e preencha com os valores do seu projeto
# (Supabase Dashboard > Project Settings > API).

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-publica

# Necessária pro login (Clerk) salvar preferências do usuário na tabela
# user_preferences — usada só em Server Actions (src/lib/preferences.ts),
# NUNCA exponha com o prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# Clerk — autenticação de usuário (login opcional, só pra salvar preferências).
# Pegue em https://dashboard.clerk.com > seu projeto > API Keys, ou instale
# via `vercel integration add clerk` (auto-provisiona essas duas).
CLERK_SECRET_KEY=sua-clerk-secret-key
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=sua-clerk-publishable-key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
