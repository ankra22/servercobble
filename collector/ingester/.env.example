# Mesmo projeto Supabase usado pelo site (.env.local na raiz do repo), mas
# aqui com a service_role key — NUNCA coloque essa chave no site.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# Caminho do arquivo que o mod (collector/mod) escreve dentro da pasta do
# servidor Minecraft.
EVENTS_FILE_PATH=C:\Users\Usuário\Documents\SERVER COBBLEMON - PROJETO\tracker-events\events.jsonl
